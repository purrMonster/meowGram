# Build the Flutter web client from the repository source.
FROM debian:bookworm-slim AS sdk

ARG FLUTTER_VERSION=3.44.4
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xz-utils zip libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" \
    https://github.com/flutter/flutter.git /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter precache --web --linux

FROM sdk AS verify
WORKDIR /app
COPY . .
RUN flutter pub get
CMD ["sh", "-ec", "flutter analyze && flutter test && flutter build web --release"]

FROM sdk AS build
ARG APP_ENV=production
ARG APP_DOMAIN=localhost
ARG HTTP_PORT=8080
ARG USE_SECURE_SCHEMES=false
ARG AUTHELIA_ISSUER_URL=http://localhost:9091
ARG AUTHELIA_CLIENT_ID=meowgram
ARG API_BASE_URL=http://localhost:8080
ARG WS_BASE_URL=ws://localhost:8080/ws
ARG WS_TICKET_ENDPOINT=/api/ws-ticket

WORKDIR /app
COPY . .
RUN flutter pub get && flutter build web --release \
    --dart-define=APP_ENV="${APP_ENV}" \
    --dart-define=APP_DOMAIN="${APP_DOMAIN}" \
    --dart-define=HTTP_PORT="${HTTP_PORT}" \
    --dart-define=USE_SECURE_SCHEMES="${USE_SECURE_SCHEMES}" \
    --dart-define=AUTHELIA_ISSUER_URL="${AUTHELIA_ISSUER_URL}" \
    --dart-define=AUTHELIA_CLIENT_ID="${AUTHELIA_CLIENT_ID}" \
    --dart-define=API_BASE_URL="${API_BASE_URL}" \
    --dart-define=WS_BASE_URL="${WS_BASE_URL}" \
    --dart-define=WS_TICKET_ENDPOINT="${WS_TICKET_ENDPOINT}"

FROM nginx:1.29-alpine
COPY nginx.web.conf /etc/nginx/nginx.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 8080
USER nginx
