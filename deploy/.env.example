# ==============================================================================
# meowGram Environment Configuration Contract
#
# INSTRUCTIONS:
# 1. Copy this file to .env (e.g., cp deploy/.env.example deploy/.env or cp deploy/.env.example .env)
# 2. Adjust values to fit your local environment or deployment target
# 3. DO NOT COMMIT .env WITH PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Domain & Host Routing
# ------------------------------------------------------------------------------
# Fully qualified domain name used for host routing, Traefik ingress, and link generation.
# Zero hardcoding rule: all host checks and routing rules source this variable.
# Local Dev: localhost
# Production: e.g. meowgram.purrbrews.cc
APP_DOMAIN=localhost

# Environment Mode
# Values: development | staging | production
ENVIRONMENT=development
APP_ENV=development

# Logging Verbosity
# Values: debug | info | warn | error
LOG_LEVEL=debug

# Enforce secure schemes (https:// and wss://) across client and server
# Local Dev: false
# Production: true
USE_SECURE_SCHEMES=false

# ------------------------------------------------------------------------------
# Port Bindings & Network Configuration
# ------------------------------------------------------------------------------
# Host port exposed on the host machine when running Docker Compose
HOST_HTTP_PORT=8080

# Internal HTTP Port bound by the server container
HTTP_PORT=8080

# WebSocket Port (unified with HTTP_PORT under standard HTTP /ws upgrade)
WS_PORT=8080

# ------------------------------------------------------------------------------
# Service Endpoint Paths & Full URL Overrides
# ------------------------------------------------------------------------------
# Base URLs for HTTP REST API and WebSocket connections.
# If omitted or empty, they are automatically computed as:
#   API_BASE_URL = http(s)://${APP_DOMAIN}:${HTTP_PORT}
#   WS_BASE_URL  = ws(s)://${APP_DOMAIN}:${HTTP_PORT}${WS_ENDPOINT}
# Local Dev: http://localhost:8080
# Production: https://meowgram.purrbrews.cc
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080/ws

# WebSocket upgrade path (default: /ws)
WS_ENDPOINT=/ws

# Catch-up synchronization REST endpoint path or full URL (UST-1.4.3)
# Default: /api/messages/sync
SYNC_ENDPOINT=/api/messages/sync

# Service health probe endpoint path or full URL
# Default: /healthz
HEALTH_ENDPOINT=/healthz

# ------------------------------------------------------------------------------
# Authelia OpenID Connect (OIDC) Identity & Auth Contract
# ------------------------------------------------------------------------------
# Authelia Domain (Fully Qualified Domain Name or host:port)
# Setting this automatically computes default endpoints for Issuer, JWKS, and Discovery!
# Local Dev: localhost:9091
# Production: auth.purrbrews.cc
AUTHELIA_DOMAIN=localhost:9091

# Base Issuer URL for Authelia OIDC provider
# Automatically derived as http(s)://${AUTHELIA_DOMAIN} if omitted
# Local Dev: http://localhost:9091
# Production: https://auth.purrbrews.cc
AUTHELIA_ISSUER=http://localhost:9091
AUTHELIA_ISSUER_URL=http://localhost:9091

# JSON Web Key Set (JWKS) URL used by the Go backend to cryptographically verify Bearer tokens
# Automatically derived as ${AUTHELIA_ISSUER}/jwks.json if omitted
# Local Dev: http://localhost:9091/jwks.json
# Production: https://auth.purrbrews.cc/jwks.json
AUTHELIA_JWKS_URL=http://localhost:9091/jwks.json

# Public OIDC Client Identifier registered in Authelia
AUTHELIA_CLIENT_ID=meowgram-client

# OpenID Discovery URL (default: ${AUTHELIA_ISSUER}/.well-known/openid-configuration)
AUTHELIA_DISCOVERY_URL=http://localhost:9091/.well-known/openid-configuration

# Authelia OIDC Endpoints (optional explicit overrides; default to standard Authelia paths)
AUTHELIA_AUTHORIZATION_ENDPOINT=http://localhost:9091/api/oidc/authorization
AUTHELIA_TOKEN_ENDPOINT=http://localhost:9091/api/oidc/token
AUTHELIA_USERINFO_ENDPOINT=http://localhost:9091/api/oidc/userinfo
AUTHELIA_REVOCATION_ENDPOINT=http://localhost:9091/api/oidc/revocation

# Explicit OAuth 2.0 / OIDC redirect URI override
# If empty, desktop resolves to RFC 8252 loopback (http://127.0.0.1:8088/callback)
# and web resolves to the hosting origin.
AUTH_REDIRECT_URI=

# Requested OIDC Scopes (space or comma separated)
OIDC_SCOPES=openid profile email offline_access

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=meowgram
POSTGRES_PASSWORD=meowgram_secret_dev_change_in_production
POSTGRES_DB=meowgram
HOST_POSTGRES_PORT=5432

# Connection string used by the Go backend (inside docker-compose, host resolves to 'postgres')
DATABASE_URL=postgres://meowgram:meowgram_secret_dev_change_in_production@postgres:5432/meowgram?sslmode=disable

# ------------------------------------------------------------------------------
# CORS & WebSocket Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins.
# Handshake validation on /ws and HTTP CORS preflight strictly inspect this list.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://localhost

# ------------------------------------------------------------------------------
# HTTP Server Timeouts (in seconds)
# ------------------------------------------------------------------------------
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Traefik Reverse Proxy Configuration (profile: proxy)
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8081

# ------------------------------------------------------------------------------
# Immich Media Routing (Release 2 Preparation)
# ------------------------------------------------------------------------------
IMMICH_DOMAIN=immich.purrbrews.cc
IMMICH_API_URL=https://immich.purrbrews.cc/api
IMMICH_API_KEY=
