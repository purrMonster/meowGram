# ==============================================================================
# meowGram Environment Configuration Contract
#
# INSTRUCTIONS:
# 1. Copy this file to .env (e.g., cp deploy/.env.example deploy/.env)
# 2. Adjust values to fit your local environment or deployment target
# 3. DO NOT COMMIT .env WITH PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Domain & Host Routing
# ------------------------------------------------------------------------------
# Fully qualified domain name used for host routing, Traefik ingress, and link generation.
# Zero hardcoding rule: all host checks and routing rules source this variable.
# Local Dev: localhost
# Production: e.g. meowgram.example.com
APP_DOMAIN=localhost

# Environment Mode
# Values: development | staging | production
ENVIRONMENT=development

# Logging Verbosity
# Values: debug | info | warn | error
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Port Bindings & Network Configuration
# ------------------------------------------------------------------------------
# Host port exposed on the host machine when running Docker Compose
HOST_HTTP_PORT=8080

# Internal HTTP Port bound by the server container
HTTP_PORT=8080

# WebSocket Port (unified with HTTP_PORT under standard HTTP /ws upgrade)
WS_PORT=8080

# ------------------------------------------------------------------------------
# CORS & WebSocket Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins.
# Handshake validation on /ws and HTTP CORS preflight strictly inspect this list.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://localhost

# ------------------------------------------------------------------------------
# HTTP Server Timeouts (in seconds)
# ------------------------------------------------------------------------------
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Traefik Reverse Proxy Configuration (profile: proxy)
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8081
