# ==============================================================================
# meowGram Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment & Secrets (NEVER COMMIT SENSITIVE CONFIG)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# ==============================================================================
# Go Backend (/server)
# ==============================================================================
server/bin/
server/dist/
server/*.exe
server/*.exe~
server/*.dll
server/*.so
server/*.dylib
server/coverage.out
server/coverage.html
server/.air.tmp/

# ==============================================================================
# Flutter Client (/client)
# ==============================================================================
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/.pub-cache/
client/.pub/
client/build/
client/ephemeral/
client/.metadata
client/ios/.generated/
client/android/.gradle/
client/android/captures/
client/android/gradlew
client/android/gradlew.bat
client/android/local.properties
client/windows/flutter/ephemeral/
client/linux/flutter/ephemeral/
client/macos/Flutter/ephemeral/

# Docker Compose overrides
deploy/docker-compose.override.yml

# ==============================================================================
# Service credentials (never commit; mount at runtime from gitignored paths)
# ==============================================================================
# Firebase / Google service-account keys (GOOGLE_APPLICATION_CREDENTIALS)
*service-account*.json
*service_account*.json
*firebase-adminsdk*.json
# Apple push (APNs) auth keys, certificates and provisioning profiles
*.p8
*.p12
*.mobileprovision
# Local secret folders (deploy/secrets is mounted into the server container)
/secrets/
deploy/secrets/*
!deploy/secrets/README.md
deploy/backups/*
!deploy/backups/README.md

# Real client build configs (tracked config/*.json hold placeholders only)
client/config/*.local.json
