# ==============================================================================
# meowGram Root Environment Configuration
#
# INSTRUCTIONS:
# Copy this file to .env in the project root:
#   cp .env.example .env
#
# Run Flutter with this .env file:
#   flutter run --dart-define-from-file=.env
#
# Run Docker Compose with this .env file:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Routing & Protocols
# ------------------------------------------------------------------------------
APP_DOMAIN=localhost
ENVIRONMENT=development
APP_ENV=development
LOG_LEVEL=debug
USE_SECURE_SCHEMES=false

# Port bindings
# Bound to loopback: the only way in is the reverse proxy (AGENTS.md)
HOST_HTTP_PORT=127.0.0.1:8080
HOST_WEB_PORT=127.0.0.1:8081
HTTP_PORT=8080
WS_PORT=8080

# ------------------------------------------------------------------------------
# Backend Service Endpoints
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080/ws
WS_ENDPOINT=/ws
WS_TICKET_ENDPOINT=/api/ws-ticket
SYNC_ENDPOINT=/api/messages/sync
HEALTH_ENDPOINT=/healthz

# ------------------------------------------------------------------------------
# Authelia Identity Provider (OIDC + PKCE)
# ------------------------------------------------------------------------------
# Setting AUTHELIA_DOMAIN automatically computes the default issuer and endpoints:
AUTHELIA_DOMAIN=localhost:9091
AUTHELIA_ISSUER=http://localhost:9091
AUTHELIA_ISSUER_URL=http://localhost:9091
AUTHELIA_JWKS_URL=http://localhost:9091/jwks.json
AUTHELIA_CLIENT_ID=meowgram

# Accepted token audience. If set, it is the ONLY accepted `aud` (strict).
# If empty, the backend accepts AUTHELIA_CLIENT_ID and https://${APP_DOMAIN}.
AUTHELIA_AUDIENCE=http://localhost:8080
AUTHELIA_DISCOVERY_URL=http://localhost:9091/.well-known/openid-configuration
AUTHELIA_AUTHORIZATION_ENDPOINT=http://localhost:9091/api/oidc/authorization
AUTHELIA_TOKEN_ENDPOINT=http://localhost:9091/api/oidc/token
AUTHELIA_USERINFO_ENDPOINT=http://localhost:9091/api/oidc/userinfo
AUTHELIA_REVOCATION_ENDPOINT=http://localhost:9091/api/oidc/revocation
AUTH_REDIRECT_URI=
# Informational: the client requests these scopes (hardcoded in AppConfig.oidcScopes)
OIDC_SCOPES=openid profile email offline_access

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
POSTGRES_USER=meowgram
# Required. Generate on each host, never commit: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=meowgram
BACKUP_RETENTION_DAYS=14
HOST_POSTGRES_PORT=127.0.0.1:5432
# Optional override. Leave unset: compose builds it from POSTGRES_* (a stale
# DATABASE_URL here would silently keep an old password).
# DATABASE_URL=postgres://meowgram:<password>@postgres:5432/meowgram?sslmode=disable

# ------------------------------------------------------------------------------
# Immich Media Routing (Release 2)
# ------------------------------------------------------------------------------
IMMICH_DOMAIN=
IMMICH_API_URL=
IMMICH_API_KEY=

# ------------------------------------------------------------------------------
# Push notifications (FCM). Put the service-account JSON in deploy/secrets/
# (gitignored; mounted at /run/secrets). Empty = push disabled.
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
